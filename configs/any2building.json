{
  "models": {
    "denoiser": {
      "name": "SpatialPromptDiT",
      "args": {
        "resolution": 16,
        "in_channels": 8,
        "out_channels": 8,
        "model_channels": 1536,
        "cond_channels": 1024,
        "num_blocks": 30,
        "num_heads": 12,
        "mlp_ratio": 5.3334,
        "pe_mode": "rope",
        "share_mod": true,
        "initialization": "scaled",
        "qk_rms_norm": true,
        "qk_rms_norm_cross": true,
        "rough_grid": 16,
        "use_checkpoint": true,
        "main_tokens": 1029
      }
    },
    "point_cond_encoder": {
      "name": "PointCloudTokenizer",
      "args": {
        "num_points": 16384,
        "center_num": [
          2048,
          1024
        ],
        "k": 16,
        "hidden_channels": 512,
        "out_channels": 1024,
        "use_pos_embed": true
      }
    },
    "condition_fuser": {
      "name": "SharedSpatialQueryConditioner",
      "args": {
        "channels": 1024,
        "num_heads": 16,
        "dropout": 0.0,
        "anchor_grid": 8,
        "algorithm": "aux",
        "rough_grid": 16,
        "prior_scale": 0.2
      }
    }
  },
  "dataset": {
    "name": "BuildingObservationDataset",
    "args": {
      "pretrained_ss_dec": "weights/structure_decoder/model",
      "normalization": null
    }
  },
  "trainer": {
    "name": "Any2BuildingTrainer",
    "args": {
      "max_steps": 2000,
      "batch_size_per_gpu": 32,
      "batch_split": 8,
      "optimizer": {
        "name": "AdamW",
        "args": {
          "lr": 1e-05,
          "weight_decay": 0.01,
          "betas": [
            0.9,
            0.95
          ],
          "eps": 1e-08
        }
      },
      "ema_rate": [
        0.9999
      ],
      "mix_precision_mode": "amp",
      "mix_precision_dtype": "bfloat16",
      "grad_clip": {
        "name": "AdaptiveGradClipper",
        "args": {
          "max_norm": 1.0,
          "clip_percentile": 95
        }
      },
      "i_print": 10,
      "i_log": 10,
      "i_sample": 2000,
      "i_save": 2000,
      "snapshot_num_samples": 16,
      "snapshot_batch_size": 1,
      "p_uncond": 0.1,
      "condition_mode_probs": [
        0.25,
        0.25,
        0.25,
        0.25
      ],
      "inference_condition_mode": "both",
      "snapshot_condition_modes": [
        "point",
        "image",
        "rough",
        "both"
      ],
      "rough_inference_lambda": 0.0,
      "t_schedule": {
        "name": "logitNormal",
        "args": {
          "mean": 1.0,
          "std": 1.0
        }
      },
      "sigma_min": 1e-05,
      "image_cond_model": {
        "name": "DinoV3FeatureExtractor",
        "args": {
          "model_name": "weights/image_tokenizer",
          "image_size": 512
        }
      },
      "rough_noise_mode": "cosine",
      "anchor_occ_weight": 0.0,
      "query_occ_weight": 0.1,
      "point_preservation_weight": 0.0,
      "point_preservation_margin_weight": 0.0,
      "output_geometry_weight": 0.02,
      "output_geometry_warmup": 2000,
      "geometry_start_step": 0
    }
  }
}
